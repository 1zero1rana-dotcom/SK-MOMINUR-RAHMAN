{
  "entities": {
    "User": {
      "title": "User",
      "description": "A student or teacher in the system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastDeviceId": { "type": "string", "description": "ID of the last device used to login" }
      },
      "required": ["uid", "email", "role"]
    },
    "Course": {
      "title": "Course",
      "description": "An online course.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "thumbnail": { "type": "string" },
        "instructorName": { "type": "string" },
        "instructorAvatar": { "type": "string" },
        "price": { "type": "number" },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "lessons": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "title": { "type": "string" },
                    "videoUrl": { "type": "string" },
                    "duration": { "type": "string" },
                    "isFree": { "type": "boolean" }
                  }
                }
              }
            }
          }
        },
        "stats": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "price"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A manual payment record via bKash.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "transactionId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "courseId", "transactionId", "amount", "status"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "A student's enrollment in a course.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "enrolledAt": { "type": "string", "format": "date-time" },
        "progress": { "type": "number" },
        "completedLessons": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["active", "completed", "dropped"] }
      },
      "required": ["userId", "courseId", "enrolledAt"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global site configuration.",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteDescription": { "type": "string" },
        "heroTitle": { "type": "string" },
        "heroSubtitle": { "type": "string" },
        "heroBadge": { "type": "string" },
        "heroFeatures": { "type": "array", "items": { "type": "string" } },
        "statsLabel": { "type": "string" },
        "statsValue": { "type": "string" },
        "categoriesTitle": { "type": "string" },
        "categoriesSubtitle": { "type": "string" },
        "coursesTitle": { "type": "string" },
        "coursesSubtitle": { "type": "string" },
        "ctaTitle": { "type": "string" },
        "ctaSubtitle": { "type": "string" },
        "testimonialsTitle": { "type": "string" },
        "testimonialsSubtitle": { "type": "string" },
        "testimonialsDescription": { "type": "string" },
        "bkashNumber": { "type": "string" },
        "paymentInstructions": { "type": "string" },
        "footerText": { "type": "string" },
        "contactEmail": { "type": "string" },
        "contactPhone": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "youtubeUrl": { "type": "string" },
        "logoUrl": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "headerLinks": { "type": "array" },
        "footerLinks": { "type": "array" },
        "language": { "type": "string" },
        "stats": { "type": "array" },
        "testimonials": { "type": "array" },
        "slides": { "type": "array" },
        "theme": { "type": "object" },
        "homeSections": { "type": "array" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "A global notification for users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["course_update", "new_course", "system"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "courseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "readBy": { "type": "array", "items": { "type": "string" }, "description": "List of user UIDs who have read this notification" }
      },
      "required": ["type", "title", "message", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Course information"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Manual payment records"
    },
    "/enrollments/{enrollmentId}": {
      "schema": "Enrollment",
      "description": "Course enrollment records"
    },
    "/settings/{docId}": {
      "schema": "SiteSettings",
      "description": "Global site settings"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Global notifications"
    }
  }
}
